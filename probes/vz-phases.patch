diff --git a/diagnostic_test.go b/diagnostic_test.go
new file mode 100644
index 0000000..c72f4cb
--- /dev/null
+++ b/diagnostic_test.go
@@ -0,0 +1,49 @@
+package vz_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"testing"
+	"time"
+)
+
+var diagnosticStarted = time.Now()
+
+func diagnosticPhase(t *testing.T, format string, args ...any) {
+	t.Helper()
+	t.Log(diagnosticJSON(t.Name(), format, args...))
+}
+
+func diagnosticLog(format string, args ...any) {
+	fmt.Println(diagnosticJSON(os.Getenv("VZ_DIAGNOSTIC_TARGET"), format, args...))
+}
+
+func diagnosticJSON(target, format string, args ...any) string {
+	count, _ := strconv.Atoi(os.Getenv("VZ_DIAGNOSTIC_COUNT"))
+	process, _ := strconv.Atoi(os.Getenv("VZ_DIAGNOSTIC_PROCESS_NUMBER"))
+	record := struct {
+		Case              string  `json:"case"`
+		Go                string  `json:"go"`
+		Target            string  `json:"target"`
+		Count             int     `json:"count"`
+		ProcessNumber     int     `json:"processNumber"`
+		Phase             string  `json:"phase"`
+		MonotonicDuration float64 `json:"monotonicDuration"`
+		ExitCode          *int    `json:"exitCode"`
+	}{
+		Case:              os.Getenv("VZ_DIAGNOSTIC_CASE"),
+		Go:                os.Getenv("VZ_DIAGNOSTIC_GO"),
+		Target:            target,
+		Count:             count,
+		ProcessNumber:     process,
+		Phase:             fmt.Sprintf(format, args...),
+		MonotonicDuration: time.Since(diagnosticStarted).Seconds(),
+	}
+	data, err := json.Marshal(record)
+	if err != nil {
+		panic(err)
+	}
+	return string(data)
+}
