+func runSerialFDTestInSubprocess(t *testing.T) bool {
+	t.Helper()
+	const childEnv = "VZ_TEST_SERIAL_FD_CHILD"
+	if os.Getenv(childEnv) == t.Name() {
+		return false
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Other tests can release VM descriptors while the count is measured.
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, executable, "-test.run=^"+regexp.QuoteMeta(t.Name())+"$", "-test.count=1", "-test.timeout=20s", "-test.v")
+	command.WaitDelay = time.Second
+	command.Env = append(os.Environ(), childEnv+"="+t.Name())
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("isolated %s failed: %v\n%s", t.Name(), err, output)
+	}
+	t.Logf("%s", output)
+	return true
+}
 
