 )
 
 var diagnosticStarted = time.Now()
@@ -47,3 +51,35 @@
 	}
 	return string(data)
 }
+
+func diagnosticIdleGuestReadback(t *testing.T, client *ssh.Client, port int) error {
+	t.Helper()
+	mode := os.Getenv("VZ_DIAGNOSTIC_IDLE")
+	if mode == "" {
+		return nil
+	}
+	diagnosticPhase(t, "idle.guest.readback.begin port=%d mode=%s", port, mode)
+	session, err := client.NewSession()
+	if err != nil {
+		return fmt.Errorf("diagnostic guest session: %w", err)
+	}
+	defer session.Close()
+	output, err := session.Output("cat /proc/cmdline && uname -r")
+	if err != nil {
+		return fmt.Errorf("diagnostic guest command: %w", err)
+	}
+	lines := strings.Split(strings.TrimSuffix(string(output), "\n"), "\n")
+	if len(lines) != 2 || strings.TrimSpace(lines[1]) == "" {
+		return fmt.Errorf("diagnostic guest readback requires command line and kernel release, got %q", output)
+	}
+	data, err := json.Marshal(map[string]any{
+		"phase": "idle.guest.readback", "target": t.Name(), "idleMode": mode,
+		"port": port, "commandLine": lines[0], "kernelRelease": lines[1],
+		"monotonicDuration": time.Since(diagnosticStarted).Seconds(), "guestReadback": true,
+	})
+	if err != nil {
+		return err
+	}
+	fmt.Fprintln(os.Stderr, string(data))
+	return vz.DiagnosticValidateIdleGuest(mode, lines[0], port)
+}
